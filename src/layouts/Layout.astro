---
import '../styles/global.css';
import { getLocaleMeta, getLocalePath, SUPPORTED_LOCALES, type Locale } from '../lib/i18n';

interface Props {
	locale: Locale;
	pathname: string;
	title?: string;
	description?: string;
}

const { 
	locale,
	pathname,
	title = getLocaleMeta(locale).title,
	description = getLocaleMeta(locale).description,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const siteOrigin = (Astro.site?.toString() ?? 'https://geroof.github.io/').replace(/\/$/, '');
const basePath = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const keywordContent = getLocaleMeta(locale).keywords;
const canonicalURL = `${siteOrigin}${basePath}${pathname}`;
const localeHref = (targetLocale: Locale) => `${basePath}${getLocalePath(targetLocale)}`;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	"name": "Web BLE Capture",
	"url": canonicalURL,
	"description": description,
	"inLanguage": locale,
	"applicationCategory": "DeveloperApplication",
	"operatingSystem": "Any with Web Bluetooth support"
};
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywordContent} />
		<link rel="canonical" href={canonicalURL} />
		{
			SUPPORTED_LOCALES.map((altLocale) => (
				<link
					rel="alternate"
					hreflang={altLocale}
					href={`${siteOrigin}${basePath}${getLocalePath(altLocale)}`}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={`${siteOrigin}${basePath}${getLocalePath('ja')}`} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script type="application/ld+json" is:inline>
			{JSON.stringify(structuredData)}
		</script>
		{
			gscVerification && (
				<meta name="google-site-verification" content={gscVerification} />
			)
		}
		{
			gaId && (
				<>
					<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
					<script is:inline define:vars={{ gaId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag('js', new Date());
						gtag('config', gaId);
					</script>
				</>
			)
		}
	</head>
	<body>
        <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16 items-center">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 7l10 10-5 5V2l5 5L7 17"></path>
                        </svg>
                        <h1 class="text-xl font-bold text-slate-900 tracking-tight">Web BLE Capture</h1>
                    </div>
                    <nav class="flex items-center gap-4">
                        <div class="flex items-center gap-1 rounded-full bg-slate-100 p-1 text-xs font-semibold">
                            {
                                SUPPORTED_LOCALES.map((altLocale) => {
                                    const isCurrent = altLocale === locale;
                                    return (
                                        <a
                                            href={localeHref(altLocale)}
                                            aria-current={isCurrent ? 'page' : undefined}
                                            class={`rounded-full px-2.5 py-1 transition-colors ${
                                                isCurrent
                                                    ? 'bg-brand-600 text-white'
                                                    : 'text-slate-600 hover:bg-white hover:text-slate-900'
                                            }`}
                                        >
                                            {altLocale.toUpperCase()}
                                        </a>
                                    );
                                })
                            }
                        </div>
                        <a href="https://github.com/GeroOf/web-ble-capture" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-slate-700 transition-colors">
                            GitHub
                        </a>
                    </nav>
                </div>
            </div>
        </header>
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    		<slot />
        </main>
	</body>
</html>
