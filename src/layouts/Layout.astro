---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Web BLE Capture | ブラウザ完結の簡易BLEパケットキャプチャ",
	description = "ブラウザだけで動作するインストール不要の軽量BLE通信キャプチャツール。Web Bluetooth APIを利用してPeripheralデバイスのGATT通信(Notify/Read等)を解析・表示します。"
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
const canonicalURL = "https://geroof.github.io/web-ble-capture/";

const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	"name": "Web BLE Capture",
	"url": canonicalURL,
	"description": description,
	"applicationCategory": "DeveloperApplication",
	"operatingSystem": "Any with Web Bluetooth support"
};
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="Web Bluetooth, BLEキャプチャ, ネットワークキャプチャ, ブラウザ完結, Web BLE Capture, GATT" />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script type="application/ld+json" is:inline>
			{JSON.stringify(structuredData)}
		</script>
		{
			gscVerification && (
				<meta name="google-site-verification" content={gscVerification} />
			)
		}
		{
			gaId && (
				<>
					<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
					<script is:inline define:vars={{ gaId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag('js', new Date());
						gtag('config', gaId);
					</script>
				</>
			)
		}
	</head>
	<body>
        <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-16 items-center">
                    <div class="flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 7l10 10-5 5V2l5 5L7 17"></path>
                        </svg>
                        <h1 class="text-xl font-bold text-slate-900 tracking-tight">Web BLE Capture</h1>
                    </div>
                    <nav class="flex gap-4">
                        <a href="https://github.com/GeroOf/web-ble-capture" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-slate-700 transition-colors">
                            GitHub
                        </a>
                    </nav>
                </div>
            </div>
        </header>
        <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    		<slot />
        </main>
	</body>
</html>
