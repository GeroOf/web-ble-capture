---
const redirectPath = `${import.meta.env.BASE_URL}ja/`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta http-equiv="refresh" content={`0;url=${redirectPath}`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>日本語ページへ移動しています</title>
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<main>
			<p>日本語ページへ移動しています。</p>
			<p><a href={redirectPath}>自動で移動しない場合はこちら</a></p>
		</main>
	</body>
</html>
