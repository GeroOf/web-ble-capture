---
import App from './App';
import Layout from '../layouts/Layout.astro';
import { translate, type Locale } from '../lib/i18n';
interface Props { locale: Locale; pathname: string; }
const { locale, pathname } = Astro.props;
const demoDefault = import.meta.env.PUBLIC_BLE_DEMO === 'true';
---
<Layout locale={locale} pathname={pathname}>
    <noscript>
        <div class="my-8 rounded-lg border border-amber-200 bg-amber-50 p-4 text-center text-amber-900">
            {translate(locale, 'fallback.jsRequired')}
        </div>
    </noscript>
    <App client:only="preact" locale={locale} demoDefault={demoDefault}>
        <div slot="fallback" class="rounded-xl border border-slate-200 bg-white p-6 text-slate-700">
            {translate(locale, 'home.heroDescription')}
        </div>
    </App>
</Layout>
